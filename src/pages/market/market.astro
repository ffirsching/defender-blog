---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import YearPriceBoxplot from "./yearPriceBoxplot.astro";
import PriceMileageScatter from "./priceMileageScatter.astro";
import comparisConfig from "../../../scraper/src/config/comparis-config.yaml";

type Listing = {
  title: string;
  url: string;
  scrapedAt: string;
  priceChf?: number;
  mileageKm?: number;
  year?: number;
  location?: string;
  type?: string;
  model?: string;
  createDate?: string;
};

type ComparisConfig = {
  models: {
    name: string;
    url: string;
  }[];
};

const { models } = comparisConfig as ComparisConfig;

function slugify(name: string) {
  return 'comparis-'.concat(
    name
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, ""));
}

const datasetModules = import.meta.glob("../../../scraper/data/*.json", {
  eager: true,
  import: "default",
}) as Record<string, unknown>;

const datasetsByKey = Object.fromEntries(
  Object.entries(datasetModules).map(([modulePath, moduleData]) => {
    const fileName = modulePath.split("/").pop()!;
    const key = fileName.replace(/^comparis-/, "").replace(/\.json$/, "");

    return [
      key,
      Array.isArray(moduleData) ? (moduleData as Listing[]) : [],
    ];
  }),
);

const availableDatasets = models
  .map((model) => {
    const key = slugify(model.name);

    return {
      key,
      label: model.name,
      url: model.url,
      fileName: `comparis-${key}.json`,
      data: datasetsByKey[key] ?? [],
    };
  })
  .sort((a, b) => a.label.localeCompare(b.label));

const selectedDatasetKey =
  Astro.url.searchParams.get("dataset") ??
  availableDatasets[0]?.key ??
  "";

const activeDataset =
  availableDatasets.find((d) => d.key === selectedDatasetKey) ??
  availableDatasets[0];

const listings = activeDataset.data.filter(
  (listing) => listing.priceChf && listing.priceChf > 0,
);

const activeCount = listings.length;
const activeDatasetLabel = activeDataset?.label ?? "Comparis";

function percentile(values: number[], fraction: number) {
  if (!values.length) return 0;
  const index = (values.length - 1) * fraction;
  const lower = Math.floor(index);
  const upper = Math.ceil(index);
  const weight = index - lower;
  return values[upper] === undefined
    ? values[lower]
    : values[lower] + (values[upper] - values[lower]) * weight;
}

const sortedPrices = listings
  .map((listing) => listing.priceChf!)
  .sort((a, b) => a - b);
const medianAskingPrice = percentile(sortedPrices, 0.5);
const q1Price = percentile(sortedPrices, 0.25);
const q3Price = percentile(sortedPrices, 0.75);
const priceIqr = q3Price - q1Price;

const byYear = new Map<number, number[]>();
const yearMileage = new Map<number, number[]>();
const pricePerThousandKm = listings
  .filter((listing) => listing.mileageKm && listing.mileageKm > 0)
  .map((listing) => listing.priceChf! / (listing.mileageKm! / 1000));

listings.forEach((listing) => {
  if (listing.year) {
    const bucket = byYear.get(listing.year) ?? [];
    bucket.push(listing.priceChf!);
    byYear.set(listing.year, bucket);

    if (listing.mileageKm && listing.mileageKm > 0) {
      const mileages = yearMileage.get(listing.year) ?? [];
      mileages.push(listing.mileageKm);
      yearMileage.set(listing.year, mileages);
    }
  }
});

const yearStats = Array.from(byYear.entries())
  .sort(([a], [b]) => a - b)
  .map(([year, prices]) => ({
    year,
    count: prices.length,
    median: percentile(
      prices.sort((a, b) => a - b),
      0.5,
    ),
  }));

const yearMedianValues = yearStats
  .map((stat) => stat.median)
  .sort((a, b) => a - b);
const yearMedianAverage = percentile(yearMedianValues, 0.5);
const yearMedianQ1 = percentile(yearMedianValues, 0.25);
const yearMedianQ3 = percentile(yearMedianValues, 0.75);
const yearMedianIqr = yearMedianQ3 - yearMedianQ1;

const yearPriceGroups = Array.from(byYear.entries())
  .sort(([a], [b]) => a - b)
  .map(([year, prices]) => {
    const sorted = [...prices].sort((a, b) => a - b);

    const q1 = percentile(sorted, 0.25);
    const median = percentile(sorted, 0.5);
    const q3 = percentile(sorted, 0.75);

    const iqr = q3 - q1;
    const lowerFence = q1 - 1.5 * iqr;
    const upperFence = q3 + 1.5 * iqr;

    const outliers = sorted.filter(
      (price) => price < lowerFence || price > upperFence,
    );

    const whiskerLow = sorted.find((price) => price >= lowerFence) ?? sorted[0];

    const whiskerHigh =
      [...sorted].reverse().find((price) => price <= upperFence) ??
      sorted[sorted.length - 1];

    const mileage = yearMileage.get(year) ?? [];

    const averageMileage =
      mileage.length > 0
        ? Math.round(
            mileage.reduce((sum, value) => sum + value, 0) / mileage.length,
          )
        : null;

    return {
      year,
      count: sorted.length,
      min: whiskerLow,
      q1,
      median,
      q3,
      max: whiskerHigh,
      outliers,
      averageMileage,
      chartPoint: sorted.length < 3 ? median : null,
    };
  });

const boxplotLabels = yearPriceGroups.map((g) => String(g.year));

const boxplotData = yearPriceGroups.map((group) =>
  group.count >= 3
    ? {
        min: group.min,
        q1: group.q1,
        median: group.median,
        q3: group.q3,
        max: group.max,
        outliers: group.outliers,
        count: group.count,
        averageMileage: group.averageMileage,
      }
    : null,
);

const insufficientYearPoints = yearPriceGroups
  .filter((group) => group.count < 3)
  .map((group) => ({
    x: boxplotLabels.indexOf(String(group.year)),
    y: group.chartPoint ?? 0,
    count: group.count,
  }));

const highestBoxValue = Math.max(
  ...yearPriceGroups.map((g) => g.max),
  ...yearPriceGroups.map((g) => g.chartPoint ?? 0),
  0,
);

const averagePricePerThousandKm = pricePerThousandKm.length
  ? pricePerThousandKm.reduce((sum, value) => sum + value, 0) /
    pricePerThousandKm.length
  : 0;
const medianPricePerThousandKm = percentile(
  pricePerThousandKm.sort((a, b) => a - b),
  0.5,
);

function parseCanton(location?: string) {
  if (!location) return "Unknown";
  const match = location.match(/\(([^)]+)\)/);
  if (match) return match[1];
  return location.split("/")[0].trim();
}

const typeCounts = new Map<string, number>();
const locationCounts = new Map<string, number>();
const weekCounts = new Map<string, number>();
const mileages = listings
  .filter((listing) => listing.mileageKm && listing.mileageKm > 0)
  .map((listing) => listing.mileageKm!)
  .sort((a, b) => a - b);

const mileageMedian = percentile(mileages, 0.5);
const mileageQ1 = percentile(mileages, 0.25);
const mileageQ3 = percentile(mileages, 0.75);
const mileageIqr = mileageQ3 - mileageQ1;

const mileageBuckets = [
  { label: "<50k km", min: 0, max: 50000 },
  { label: "50–100k km", min: 50000, max: 100000 },
  { label: "100–150k km", min: 100000, max: 150000 },
  { label: "150–200k km", min: 150000, max: 200000 },
  { label: "200k+ km", min: 200000, max: Infinity },
].map((range) => {
  const bucketPrices = listings
    .filter(
      (listing) =>
        listing.priceChf &&
        listing.priceChf > 0 &&
        listing.mileageKm &&
        listing.mileageKm > 0 &&
        listing.mileageKm > range.min &&
        listing.mileageKm <= range.max,
    )
    .map((listing) => listing.priceChf!)
    .sort((a, b) => a - b);

  return {
    label: range.label,
    count: bucketPrices.length,
    medianPrice: bucketPrices.length ? percentile(bucketPrices, 0.5) : null,
  };
});

const now = new Date();
const dayMs = 1000 * 60 * 60 * 24;
const ageDays = listings
  .map((listing) => {
    if (!listing.createDate) return undefined;
    const created = new Date(listing.createDate);
    if (Number.isNaN(created.valueOf())) return undefined;
    return Math.max(0, Math.round((now.valueOf() - created.valueOf()) / dayMs));
  })
  .filter((value): value is number => typeof value === "number");

listings.forEach((listing) => {
  const type = listing.type ?? listing.model ?? "Unknown";
  typeCounts.set(type, (typeCounts.get(type) ?? 0) + 1);

  const canton = parseCanton(listing.location);
  locationCounts.set(canton, (locationCounts.get(canton) ?? 0) + 1);

  if (listing.createDate) {
    const created = new Date(listing.createDate);
    if (!Number.isNaN(created.valueOf())) {
      const weekIndex = Math.floor(created.valueOf() / (7 * dayMs));
      const weekKey = `${created.getFullYear()}-W${weekIndex}`;
      weekCounts.set(weekKey, (weekCounts.get(weekKey) ?? 0) + 1);
    }
  }
});

const averageDaysOnMarket = ageDays.length
  ? Math.round(ageDays.reduce((sum, value) => sum + value, 0) / ageDays.length)
  : 0;

const recentWeeks = Array.from(weekCounts.entries())
  .sort(([a], [b]) => a.localeCompare(b))
  .slice(-8)
  .map(([week, count]) => ({ week, count }));

const typeAvailability = Array.from(typeCounts.entries())
  .sort(([, a], [, b]) => b - a)
  .slice(0, 8);

const modelSegmentation = Array.from(typeCounts.entries())
  .sort(([, a], [, b]) => b - a)
  .map(([model, count]) => {
    const modelListings = listings.filter(
      (listing) => (listing.type ?? listing.model ?? "Unknown") === model,
    );
    const prices = modelListings
      .filter((listing) => listing.priceChf && listing.priceChf > 0)
      .map((listing) => listing.priceChf!)
      .sort((a, b) => a - b);
    const mileages = modelListings
      .filter((listing) => listing.mileageKm && listing.mileageKm > 0)
      .map((listing) => listing.mileageKm!)
      .sort((a, b) => a - b);

    return {
      model,
      count,
      medianPrice: prices.length ? percentile(prices, 0.5) : null,
      medianMileage: mileages.length ? percentile(mileages, 0.5) : null,
    };
  });

const cantonModelMatrix = Array.from(locationCounts.keys()).map((canton) => {
  const row: Record<string, number | string> = { canton };

  models.forEach((model) => {
    row[model] = listings.filter(
      (listing) =>
        parseCanton(listing.location) === canton &&
        (listing.type ?? listing.model ?? "Unknown") === model,
    ).length;
  });

  row.total = locationCounts.get(canton) ?? 0;

  return row;
});

const topCantons = Array.from(locationCounts.entries())
  .sort(([, a], [, b]) => b - a)
  .slice(0, 3);

const supplyConcentration =
  activeCount > 0
    ? Math.round(
        (topCantons.reduce((sum, [, count]) => sum + count, 0) / activeCount) *
          100,
      )
    : 0;

const modelScarcity = modelSegmentation
  .map((model) => ({
    ...model,
    scarcity: Math.round(
      (1 - model.count / Math.max(...modelSegmentation.map((m) => m.count))) *
        100,
    ),
  }))
  .sort((a, b) => b.scarcity - a.scarcity);

const inventoryAgeBuckets = [
  { label: "0–7 days", min: 0, max: 7 },
  { label: "8–30 days", min: 8, max: 30 },
  { label: "31–90 days", min: 31, max: 90 },
  { label: "90+ days", min: 91, max: Infinity },
].map((bucket) => ({
  label: bucket.label,
  count: ageDays.filter((age) => age >= bucket.min && age <= bucket.max).length,
}));

const searchDifficulty = Math.round(
  (1 - activeCount / 200) * 50 +
    (1 - locationCounts.size / 26) * 25 +
    (mileageMedian / 250000) * 25,
);

const locationAvailability = Array.from(locationCounts.entries())
  .sort(([, a], [, b]) => b - a)
  .slice(0, 8);

const highestYearMedian =
  yearStats.reduce((max, stat) => Math.max(max, stat.median), 0) || 1;
const highestTypeCount = typeAvailability[0]?.[1] ?? 1;
const highestLocationCount = locationAvailability[0]?.[1] ?? 1;
const highestMileageCount = Math.max(
  ...mileageBuckets.map((bucket) => bucket.count),
  1,
);

const priceMileagePoints = listings
  .filter(
    (listing) =>
      listing.priceChf &&
      listing.priceChf > 0 &&
      listing.mileageKm &&
      listing.mileageKm > 0,
  )
  .map((listing) => ({
    x: listing.mileageKm!,
    y: listing.priceChf!,
  }));
---

<Layout>
  <Navigation />
  <main class="dashboard">
    <header>
      <div>
        <p class="eyebrow">Defender Market Intelligence</p>
        <h1>Swiss Defender Market Dashboard</h1>
        <p class="intro">
          Analysis based on {activeCount} active {activeDatasetLabel} Defender listings in Switzerland.
        </p>
      </div>
      <div class="dataset-toolbar">
        <label for="dataset-select">Dataset</label>
        <form method="get" class="dataset-form">
          <select id="dataset-select" name="dataset" onchange="this.form.submit()">
            {
              availableDatasets.map((dataset) => (
                <option value={dataset.key} selected={dataset.key === activeDataset?.key}>
                  {dataset.label}
                </option>
              ))
            }
          </select>
        </form>
      </div>

      <div class="stats-grid">
        <article>
          <span>Active listings</span>
          <strong>{activeCount}</strong>
        </article>
        <article>
          <span>Median asking price</span>
          <strong>CHF {medianAskingPrice.toLocaleString("de-CH")}</strong>
        </article>
        <article>
          <span>Average days on market</span>
          <strong>{averageDaysOnMarket}</strong>
        </article>
        <article>
          <span>New listings / week</span>
          <strong
            >{recentWeeks.reduce((sum, week) => sum + week.count, 0)}</strong
          >
        </article>
      </div>
    </header>

    <section class="section">
      <h2>Market value</h2>
      <div class="card-grid">
        <article class="card full-width">
          <h3>Price distribution by build year</h3>
          <div class="chart-container">
            <canvas id="yearBoxplot"></canvas>
          </div>
        </article>

        <article class="card">
          <h3>Median asking price</h3>
          <p>Current market value for Defender listings in Switzerland.</p>
          <div class="metric">
            CHF {medianAskingPrice.toLocaleString("de-CH")}
          </div>
          <dl>
            <div>
              <dt>25th percentile</dt><dd>
                CHF {q1Price.toLocaleString("de-CH")}
              </dd>
            </div>
            <div>
              <dt>75th percentile</dt><dd>
                CHF {q3Price.toLocaleString("de-CH")}
              </dd>
            </div>
            <div>
              <dt>IQR</dt><dd>CHF {priceIqr.toLocaleString("de-CH")}</dd>
            </div>
          </dl>
        </article>

        <article class="card">
          <h3>Price per mileage</h3>
          <p>
            Price per 1,000 km helps compare cars of different odometer
            readings.
          </p>
          <div class="metric">
            CHF {Math.round(averagePricePerThousandKm).toLocaleString("de-CH")} /
            1,000 km
          </div>
          <div class="subtext">
            Median: CHF {
              Math.round(medianPricePerThousandKm).toLocaleString("de-CH")
            }
          </div>
        </article>

        <article class="card">
          <h3>Price distribution</h3>
          <p>
            25–75% range identifies the normal market band for Defender prices.
          </p>
          <div class="distribution">
            <span>CHF {q1Price.toLocaleString("de-CH")}</span>
            <div class="range-bar">
              <div
                class="range-fill"
                style={{
                  left: `${(q1Price / q3Price) * 100}%`,
                  width: `${((q3Price - q1Price) / q3Price) * 100}%`,
                }}
              >
              </div>
            </div>
            <span>CHF {q3Price.toLocaleString("de-CH")}</span>
          </div>
          <p class="subtext">
            Median CHF {medianAskingPrice.toLocaleString("de-CH")}
          </p>
        </article>

        <article class="card full-width">
          <h3>Price vs mileage</h3>
          <PriceMileageScatter points={priceMileagePoints} />
        </article>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Supply</h2>
        <p>Market depth, liquidity and availability across Swiss regions.</p>
      </div>

      <div class="card-grid">
        <article class="card">
          <h3>Active listings</h3>
          <p>Total Defender listings currently visible in the snapshot.</p>
          <div class="metric">{activeCount}</div>
        </article>

        <article class="card">
          <h3>Average days on market</h3>
          <p>Approximate time since first seen on Comparis.</p>
          <div class="metric">{averageDaysOnMarket} days</div>
        </article>

        <article class="card">
          <h3>New listings per week</h3>
          <div class="mini-chart">
            {
              recentWeeks.map((week) => (
                <div class="bar-row">
                  <span>{week.week}</span>
                  <div class="bar-shell">
                    <div
                      class="bar"
                      style={{
                        width: `${(week.count / Math.max(...recentWeeks.map((w) => w.count))) * 100}%`,
                      }}
                    />
                  </div>
                  <strong>{week.count}</strong>
                </div>
              ))
            }
          </div>
        </article>
      </div>
    </section>

    <section class="section">
      <h2>Availability snapshot</h2>
      <div class="table-grid">
        <article class="card wide">
          <h3>Model segmentation matrix</h3>
          <div class="segmentation-table">
            <div class="segmentation-row heading">
              <span>Model</span>
              <span>Count</span>
              <span>Median Price</span>
              <span>Median KM</span>
            </div>
            {
              modelSegmentation.map((model) => (
                <div class="segmentation-row">
                  <span>{model.model}</span>
                  <strong>{model.count}</strong>
                  <strong>
                    {model.medianPrice !== null
                      ? `CHF ${Math.round(model.medianPrice).toLocaleString("de-CH")}`
                      : "—"}
                  </strong>
                  <strong>
                    {model.medianMileage !== null
                      ? `${Math.round(model.medianMileage).toLocaleString("de-CH")} km`
                      : "—"}
                  </strong>
                </div>
              ))
            }
          </div>
        </article>

        <article class="card wide">
          <h3>Listings by canton</h3>
          <ul>
            {
              locationAvailability.map(([canton, count]) => (
                <li>
                  <span>{canton}</span>
                  <strong>{count}</strong>
                </li>
              ))
            }
          </ul>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <h2>Mileage profile</h2>
        <p>How Defender availability is distributed by odometer reading.</p>
        <section class="section">
  <div class="section-header">
    <h2>Availability intelligence</h2>
    <p>
      Regional supply concentration, model scarcity and inventory accessibility.
    </p>
  </div>

  <div class="card-grid">

    <article class="card">
      <h3>Supply concentration</h3>

      <div class="metric">
        {supplyConcentration}%
      </div>

      <p>
        Share of listings located in the three largest Defender markets.
      </p>

      <ul>
        {
          topCantons.map(([canton, count]) => (
            <li>
              <span>{canton}</span>
              <strong>{count}</strong>
            </li>
          ))
        }
      </ul>
    </article>


    <article class="card">
      <h3>Search difficulty</h3>

      <div class="metric">
        {searchDifficulty}/100
      </div>

      <p>
        Higher scores indicate fewer choices and harder sourcing.
      </p>

      <div class="range-bar">
        <div
          class="range-fill"
          style={{ width: `${searchDifficulty}%` }}
        />
      </div>
    </article>


    <article class="card">
      <h3>Inventory freshness</h3>

      <div class="mini-chart">
        {
          inventoryAgeBuckets.map((bucket) => (
            <div class="bar-row">
              <span>{bucket.label}</span>

              <div class="bar-shell">
                <div
                  class="bar"
                  style={{
                    width: `${
                      (bucket.count /
                        Math.max(
                          ...inventoryAgeBuckets.map(
                            (b) => b.count,
                          ),
                          1,
                        )) *
                      100
                    }%`,
                  }}
                />
              </div>

              <strong>{bucket.count}</strong>
            </div>
          ))
        }
      </div>
    </article>


    <article class="card wide">
      <h3>Model scarcity ranking</h3>

      <div class="segmentation-table">
        {
          modelScarcity.map((model) => (
            <div class="segmentation-row">
              <span>{model.model}</span>
              <strong>{model.count}</strong>
              <strong>
                {model.scarcity}% scarcity
              </strong>

              <div class="bar-shell">
                <div
                  class="bar"
                  style={{
                    width: `${model.scarcity}%`,
                  }}
                />
              </div>
            </div>
          ))
        }
      </div>
    </article>


    <article class="card wide">
      <h3>Canton × model availability</h3>

      <div class="segmentation-table">

        {
          cantonModelMatrix.map((row) => (
            <div class="segmentation-row">
              <strong>{row.canton}</strong>

              {
                models.slice(0,4).map((model) => (
                  <span>
                    {model.split(" ").slice(0,2).join(" ")}:
                    {row[model]}
                  </span>
                ))
              }

              <strong>
                Total {row.total}
              </strong>

            </div>
          ))
        }

      </div>
    </article>

  </div>
</section>
      </div>

      <div class="card-grid">
        <article class="card">
          <h3>Median mileage</h3>
          <div class="metric">
            {Math.round(mileageMedian).toLocaleString("de-CH")} km
          </div>
          <p class="subtext">
            Q1: {Math.round(mileageQ1).toLocaleString("de-CH")} km · Q3: {
              Math.round(mileageQ3).toLocaleString("de-CH")
            } km
          </p>
          <p class="subtext">
            IQR: {Math.round(mileageIqr).toLocaleString("de-CH")} km
          </p>
        </article>

        <article class="card">
          <h3>Mileage buckets</h3>
          <div class="mini-chart">
            {
              mileageBuckets.map((bucket) => (
                <div class="bar-row">
                  <span>{bucket.label}</span>
                  <div class="bar-shell">
                    <div
                      class="bar"
                      style={{
                        width: `${(bucket.count / Math.max(...mileageBuckets.map((b) => b.count))) * 100}%`,
                      }}
                    />
                  </div>
                  <span class="bucket-price">
                    {bucket.medianPrice !== null
                      ? `CHF ${Math.round(bucket.medianPrice).toLocaleString("de-CH")}`
                      : "—"}
                  </span>
                  <strong>{bucket.count}</strong>
                </div>
              ))
            }
          </div>
        </article>

        <article class="card">
          <h3>Mileage distribution</h3>
          <div class="distribution">
            <span>{Math.round(mileageQ1).toLocaleString("de-CH")} km</span>
            <div class="range-bar">
              <div
                class="range-fill"
                style={{
                  left: `${(mileageQ1 / Math.max(...mileages, 1)) * 100}%`,
                  width: `${((mileageQ3 - mileageQ1) / Math.max(...mileages, 1)) * 100}%`,
                }}
              >
              </div>
            </div>
            <span>{Math.round(mileageQ3).toLocaleString("de-CH")} km</span>
          </div>
          <p class="subtext">
            Median: {Math.round(mileageMedian).toLocaleString("de-CH")} km
          </p>
        </article>
      </div>
    </section>
  </main>
</Layout>

