---
import Layout from "../../layouts/Layout.astro";
import Navigation from "../../components/Navigation.astro";
import comparisConfig from "../../../scraper/src/config/comparis-config.yaml";
type ComparisConfig = { models: { name: string; url: string }[] };
const { models } = comparisConfig as ComparisConfig;
function slugify(name: string) {
  return "comparis-".concat(
    name
      .toLowerCase()
      .trim()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-+|-+$/g, ""),
  );
}
const availableDatasets = models
  .map((model) => ({
    key: slugify(model.name),
    label: model.name,
    url: model.url,
  }))
  .sort((a, b) => a.label.localeCompare(b.label));
const defaultDataset = availableDatasets[0];
---

<Layout>
  <Navigation />
  <main class="dashboard">
    <header>
      <div>
        <p class="eyebrow">Defender Market Intelligence</p>
        <h1>Swiss Defender Market Dashboard</h1>
        <p class="intro">
          Client-side analysis of active Defender listings in Switzerland.
        </p>
      </div>
      <div class="dataset-toolbar">
        <label for="dataset-select">Model</label>
        <select id="dataset-select" data-dataset-key={defaultDataset?.key ?? ""}>
          {
            availableDatasets.map((dataset) => (
              <option
                value={dataset.key}
                selected={dataset.key === defaultDataset?.key}
              >
                {" "}
                {dataset.label}{" "}
              </option>
            ))
          }
        </select>
        <span id="loading-state" class="loading-state" hidden> Loading… </span>
      </div>
      <div class="stats-grid">
        <article>
          <span>Active listings</span>
          <strong id="stat-active">—</strong>
        </article>
        <article>
          <span>Median asking price</span>
          <strong id="stat-price">—</strong>
        </article>
        <article>
          <span>Average days on market</span>
          <strong id="stat-days">—</strong>
        </article>
        <article>
          <span>New listings / week</span>
          <strong id="stat-new">—</strong>
        </article>
      </div>
    </header>
    <!-- ============================================================ MARKET VALUE ============================================================ -->
    <section class="section">
      <h2>Market value</h2>
      <div class="card-grid">
        <article class="card full-width">
          <h3>Price distribution by build year</h3>
          <div class="chart-container"><canvas id="year-boxplot"></canvas></div>
        </article>
        <article class="card">
          <h3>Median asking price</h3>
          <p>Current market value for Defender listings in Switzerland.</p>
          <div id="median-price" class="metric">—</div>
          <dl>
            <div><dt>25th percentile</dt> <dd id="price-q1">—</dd></div>
            <div><dt>75th percentile</dt> <dd id="price-q3">—</dd></div>
            <div><dt>IQR</dt> <dd id="price-iqr">—</dd></div>
          </dl>
        </article>
        <article class="card">
          <h3>Price per mileage</h3>
          <p>
            Price per 1,000 km helps compare cars with different odometer
            readings.
          </p>
          <div id="price-per-km" class="metric">—</div>
          <div id="median-price-per-km" class="subtext">Median: —</div>
        </article>
        <article class="card">
          <h3>Price distribution</h3>
          <p>The 25–75% range identifies the normal market band.</p>
          <div class="distribution">
            <span id="distribution-q1">—</span>
            <div class="range-bar">
              <div id="price-range-fill" class="range-fill"></div>
            </div>
            <span id="distribution-q3">—</span>
          </div>
          <p id="distribution-median" class="subtext">Median —</p>
        </article>
        <article class="card full-width">
          <h3>Price vs mileage</h3>
          <div class="chart-container scatter-container">
            <canvas id="price-mileage-scatter"></canvas>
          </div>
        </article>
      </div>
    </section>
    <!-- ============================================================ SUPPLY ============================================================ -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2>Supply</h2>
          <p>Market depth, liquidity and availability across Swiss regions.</p>
        </div>
      </div>
      <div class="card-grid">
        <article class="card">
          <h3>Active listings</h3>
          <p>Total Defender listings currently visible in the snapshot.</p>
          <div id="supply-active" class="metric">—</div>
        </article>
        <article class="card">
          <h3>Average days on market</h3>
          <p>Approximate time since the listing was created.</p>
          <div id="supply-days" class="metric">—</div>
        </article>
        <article class="card">
          <h3>New listings per week</h3>
          <div id="weekly-listings" class="mini-chart"></div>
        </article>
      </div>
    </section>
    <!-- ============================================================ AVAILABILITY ============================================================ -->
    <section class="section">
      <h2>Availability snapshot</h2>
      <div class="table-grid">
        <article class="card wide">
          <h3>Model segmentation</h3>
          <div id="model-segmentation" class="segmentation-table"></div>
        </article>
        <article class="card wide">
          <h3>Listings by canton</h3>
          <ul id="canton-list"></ul>
        </article>
      </div>
    </section>
    <!-- ============================================================ MILEAGE ============================================================ -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2>Mileage profile</h2>
          <p>How Defender availability is distributed by odometer reading.</p>
        </div>
      </div>
      <div class="card-grid">
        <article class="card">
          <h3>Median mileage</h3>
          <div id="median-mileage" class="metric">—</div>
          <p id="mileage-percentiles" class="subtext">Q1: — · Q3: —</p>
          <p id="mileage-iqr" class="subtext">IQR: —</p>
        </article>
        <article class="card">
          <h3>Mileage buckets</h3>
          <div id="mileage-buckets" class="mini-chart"></div>
        </article>
        <article class="card">
          <h3>Mileage distribution</h3>
          <div class="distribution">
            <span id="mileage-q1">—</span>
            <div class="range-bar">
              <div id="mileage-range-fill" class="range-fill"></div>
            </div>
            <span id="mileage-q3">—</span>
          </div>
          <p id="mileage-median" class="subtext">Median: —</p>
        </article>
      </div>
    </section>
    <!-- ============================================================ AVAILABILITY INTELLIGENCE ============================================================ -->
    <section class="section">
      <div class="section-header">
        <div>
          <h2>Availability intelligence</h2>
          <p>
            Regional supply concentration, model scarcity and inventory
            accessibility.
          </p>
        </div>
      </div>
      <div class="card-grid">
        <article class="card">
          <h3>Supply concentration</h3>
          <div id="supply-concentration" class="metric">—</div>
          <p>
            Share of listings located in the three largest Defender markets.
          </p>
          <ul id="top-cantons"></ul>
        </article>
        <article class="card">
          <h3>Search difficulty</h3>
          <div id="search-difficulty" class="metric">—</div>
          <p>Higher scores indicate fewer choices and harder sourcing.</p>
          <div class="range-bar">
            <div id="search-difficulty-fill" class="range-fill"></div>
          </div>
        </article>
        <article class="card">
          <h3>Inventory freshness</h3>
          <div id="inventory-age" class="mini-chart"></div>
        </article>
        <article class="card wide">
          <h3>Model scarcity ranking</h3>
          <div id="model-scarcity" class="segmentation-table"></div>
        </article>
        <article class="card wide">
          <h3>Canton availability</h3>
          <div id="canton-availability" class="segmentation-table"></div>
        </article>
      </div>
    </section>
    <div id="error-state" class="error-state" hidden></div>
  </main>
</Layout>

<script>
  const selectEl = document.querySelector("#dataset-select");
  const defaultDatasetKey =
    selectEl?.getAttribute("data-dataset-key") ?? "";
  type Listing = {
    title: string;
    url: string;
    scrapedAt: string;
    priceChf?: number;
    mileageKm?: number;
    year?: number;
    location?: string;
    type?: string;
    model?: string;
    createDate?: string;
  };
  type ModelDefinition = { key: string; label: string };
  const models: ModelDefinition[] = [
    { key: "comparis-defender-90", label: "Defender 90" },
  ];
  /* * The model list is also available in the server-rendered <select>. * Read it here rather than duplicating the configuration in the script. */ const select =
    document.querySelector<HTMLSelectElement>("#dataset-select");
  const availableModels: ModelDefinition[] = select
    ? Array.from(select.options).map((option) => ({
        key: option.value,
        label: option.textContent?.trim() ?? option.value,
      }))
    : models;
  const numberFormatter = new Intl.NumberFormat("de-CH");
  const formatNumber = (value: number) =>
    numberFormatter.format(Math.round(value));
  const formatChf = (value: number) => `CHF ${formatNumber(value)}`;
  function percentile(values: number[], fraction: number) {
    if (!values.length) return 0;
    const sorted = [...values].sort((a, b) => a - b);
    const index = (sorted.length - 1) * fraction;
    const lower = Math.floor(index);
    const upper = Math.ceil(index);
    const weight = index - lower;
    if (sorted[upper] === undefined) {
      return sorted[lower];
    }
    return sorted[lower] + (sorted[upper] - sorted[lower]) * weight;
  }
  function escapeHtml(value: unknown) {
    return String(value ?? "")
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");
  }
  function parseCanton(location?: string) {
    if (!location) return "Unknown";
    const match = location.match(/\(([^)]+)\)/);
    if (match) {
      return match[1];
    }
    return location.split("/")[0].trim();
  }
  function getModelName(listing: Listing) {
    return listing.type ?? listing.model ?? "Unknown";
  }
  function getAgeDays(listing: Listing) {
    if (!listing.createDate) return undefined;
    const created = new Date(listing.createDate);
    if (Number.isNaN(created.valueOf())) {
      return undefined;
    }
    const now = new Date();
    return Math.max(
      0,
      Math.round((now.valueOf() - created.valueOf()) / (1000 * 60 * 60 * 24)),
    );
  }
  function setText(id: string, value: string | number) {
    const element = document.getElementById(id);
    if (element) {
      element.textContent = String(value);
    }
  }
  function setHidden(id: string, hidden: boolean) {
    const element = document.getElementById(id);
    if (element) {
      element.toggleAttribute("hidden", hidden);
    }
  }
  function clearDashboard() {
    const ids = [
      "stat-active",
      "stat-price",
      "stat-days",
      "stat-new",
      "median-price",
      "price-q1",
      "price-q3",
      "price-iqr",
      "price-per-km",
      "median-price-per-km",
      "distribution-q1",
      "distribution-q3",
      "distribution-median",
      "supply-active",
      "supply-days",
      "median-mileage",
      "mileage-percentiles",
      "mileage-iqr",
      "mileage-q1",
      "mileage-q3",
      "mileage-median",
      "supply-concentration",
      "search-difficulty",
    ];
    ids.forEach((id) => setText(id, "—"));
    [
      "weekly-listings",
      "model-segmentation",
      "canton-list",
      "mileage-buckets",
      "top-cantons",
      "inventory-age",
      "model-scarcity",
      "canton-availability",
    ].forEach((id) => {
      const element = document.getElementById(id);
      if (element) {
        element.innerHTML = "";
      }
    });
    const priceRange = document.getElementById("price-range-fill");
    const mileageRange = document.getElementById("mileage-range-fill");
    const difficultyRange = document.getElementById("search-difficulty-fill");
    if (priceRange) {
      priceRange.style.left = "0";
      priceRange.style.width = "0";
    }
    if (mileageRange) {
      mileageRange.style.left = "0";
      mileageRange.style.width = "0";
    }
    if (difficultyRange) {
      difficultyRange.style.width = "0";
    }
    clearCanvas("year-boxplot");
    clearCanvas("price-mileage-scatter");
  }
  function clearCanvas(id: string) {
    const canvas = document.getElementById(id) as HTMLCanvasElement | null;
    if (!canvas) return;
    const context = canvas.getContext("2d");
    if (!context) return;
    context.clearRect(0, 0, canvas.width, canvas.height);
  }
  function drawPriceMileageScatter(listings: Listing[]) {
    const canvas = document.getElementById(
      "price-mileage-scatter",
    ) as HTMLCanvasElement | null;
    if (!canvas) return;
    const rect = canvas.getBoundingClientRect();
    const width = Math.max(rect.width, 600);
    const height = 360;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.scale(dpr, dpr);
    const points = listings
      .filter(
        (listing) =>
          listing.priceChf &&
          listing.priceChf > 0 &&
          listing.mileageKm &&
          listing.mileageKm > 0,
      )
      .map((listing) => ({ x: listing.mileageKm!, y: listing.priceChf! }));
    if (!points.length) {
      ctx.fillStyle = "#666";
      ctx.font = "14px Inter, system-ui, sans-serif";
      ctx.fillText("No mileage data available.", 20, 30);
      return;
    }
    const padding = { top: 20, right: 20, bottom: 45, left: 65 };
    const plotWidth = width - padding.left - padding.right;
    const plotHeight = height - padding.top - padding.bottom;
    const maxX = Math.max(...points.map((point) => point.x), 1);
    const maxY = Math.max(...points.map((point) => point.y), 1);
    ctx.strokeStyle = "#e5e7eb";
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = padding.top + (plotHeight / 4) * i;
      ctx.beginPath();
      ctx.moveTo(padding.left, y);
      ctx.lineTo(width - padding.right, y);
      ctx.stroke();
    }
    ctx.fillStyle = "#4f46e5";
    for (const point of points) {
      const x = padding.left + (point.x / maxX) * plotWidth;
      const y = padding.top + plotHeight - (point.y / maxY) * plotHeight;
      ctx.globalAlpha = 0.55;
      ctx.beginPath();
      ctx.arc(x, y, 3.5, 0, Math.PI * 2);
      ctx.fill();
    }
    ctx.globalAlpha = 1;
    ctx.fillStyle = "#555";
    ctx.font = "12px Inter, system-ui, sans-serif";
    ctx.fillText("Mileage (km)", width / 2 - 35, height - 10);
    ctx.save();
    ctx.translate(15, height / 2);
    ctx.rotate(-Math.PI / 2);
    ctx.fillText("Price (CHF)", 0, 0);
    ctx.restore();
  }
  function drawYearBoxplot(listings: Listing[]) {
    const canvas = document.getElementById(
      "year-boxplot",
    ) as HTMLCanvasElement | null;
    if (!canvas) return;
    const groups = new Map<number, number[]>();
    listings.forEach((listing) => {
      if (listing.year && listing.priceChf && listing.priceChf > 0) {
        const prices = groups.get(listing.year) ?? [];
        prices.push(listing.priceChf);
        groups.set(listing.year, prices);
      }
    });
    const years = Array.from(groups.keys()).sort((a, b) => a - b);
    if (!years.length) {
      clearCanvas("year-boxplot");
      return;
    }
    const rect = canvas.getBoundingClientRect();
    const width = Math.max(rect.width, 700);
    const height = Math.max(380, Math.min(520, years.length * 45));
    const dpr = window.devicePixelRatio || 1;
    canvas.width = width * dpr;
    canvas.height = height * dpr;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;
    ctx.scale(dpr, dpr);
    const padding = { top: 20, right: 25, bottom: 45, left: 70 };
    const plotWidth = width - padding.left - padding.right;
    const plotHeight = height - padding.top - padding.bottom;
    const allPrices = years.flatMap((year) => groups.get(year) ?? []);
    const maxPrice = Math.max(...allPrices, 1);
    ctx.strokeStyle = "#e5e7eb";
    ctx.lineWidth = 1;
    for (let i = 0; i <= 4; i++) {
      const y = padding.top + (plotHeight / 4) * i;
      ctx.beginPath();
      ctx.moveTo(padding.left, y);
      ctx.lineTo(width - padding.right, y);
      ctx.stroke();
      const value = maxPrice - (maxPrice / 4) * i;
      ctx.fillStyle = "#666";
      ctx.font = "11px Inter, system-ui, sans-serif";
      ctx.fillText(formatChf(value), 5, y + 4);
    }
    const slotWidth = plotWidth / Math.max(years.length, 1);
    years.forEach((year, index) => {
      const values = [...(groups.get(year) ?? [])].sort((a, b) => a - b);
      if (!values.length) return;
      const q1 = percentile(values, 0.25);
      const median = percentile(values, 0.5);
      const q3 = percentile(values, 0.75);
      const iqr = q3 - q1;
      const lowerFence = q1 - 1.5 * iqr;
      const upperFence = q3 + 1.5 * iqr;
      const whiskerLow =
        values.find((value) => value >= lowerFence) ?? values[0];
      const whiskerHigh =
        [...values].reverse().find((value) => value <= upperFence) ??
        values[values.length - 1];
      const centerX = padding.left + slotWidth * index + slotWidth / 2;
      const valueToY = (value: number) =>
        padding.top + plotHeight - (value / maxPrice) * plotHeight;
      const yQ1 = valueToY(q1);
      const yMedian = valueToY(median);
      const yQ3 = valueToY(q3);
      const yLow = valueToY(whiskerLow);
      const yHigh = valueToY(whiskerHigh);
      const boxWidth = Math.min(36, slotWidth * 0.55);
      ctx.strokeStyle = "#111827";
      ctx.fillStyle = "rgba(79, 70, 229, 0.18)";
      ctx.lineWidth = 1.5;
      ctx.beginPath();
      ctx.rect(centerX - boxWidth / 2, yQ3, boxWidth, Math.max(1, yQ1 - yQ3));
      ctx.fill();
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(centerX - boxWidth / 2, yMedian);
      ctx.lineTo(centerX + boxWidth / 2, yMedian);
      ctx.stroke();
      ctx.beginPath();
      ctx.moveTo(centerX, yQ3);
      ctx.lineTo(centerX, yHigh);
      ctx.moveTo(centerX, yQ1);
      ctx.lineTo(centerX, yLow);
      ctx.stroke();
      const capWidth = boxWidth * 0.6;
      ctx.beginPath();
      ctx.moveTo(centerX - capWidth / 2, yHigh);
      ctx.lineTo(centerX + capWidth / 2, yHigh);
      ctx.moveTo(centerX - capWidth / 2, yLow);
      ctx.lineTo(centerX + capWidth / 2, yLow);
      ctx.stroke();
      ctx.fillStyle = "#555";
      ctx.font = "11px Inter, system-ui, sans-serif";
      ctx.textAlign = "center";
      ctx.fillText(String(year), centerX, height - 15);
    });
    ctx.textAlign = "start";
  }
  function renderBars(
    containerId: string,
    rows: { label: string; value: number; secondary?: string }[],
  ) {
    const container = document.getElementById(containerId);
    if (!container) return;
    if (!rows.length) {
      container.innerHTML = `<p class="subtext">No data available.</p>`;
      return;
    }
    const maxValue = Math.max(...rows.map((row) => row.value), 1);
    container.innerHTML = rows
      .map(
        (row) =>
          ` <div class="bar-row"> <span>${escapeHtml(row.label)}</span> <div class="bar-shell"> <div class="bar" style="width:${(row.value / maxValue) * 100}%" ></div> </div> ${row.secondary ? `<span class="bucket-price">${escapeHtml(row.secondary)}</span>` : ""} <strong>${formatNumber(row.value)}</strong> </div> `,
      )
      .join("");
  }
  function renderModelSegmentation(listings: Listing[]) {
    const container = document.getElementById("model-segmentation");
    if (!container) return;
    const counts = new Map<string, Listing[]>();
    listings.forEach((listing) => {
      const model = getModelName(listing);
      const entries = counts.get(model) ?? [];
      entries.push(listing);
      counts.set(model, entries);
    });
    const rows = Array.from(counts.entries())
      .sort(([, a], [, b]) => b.length - a.length)
      .map(([model, entries]) => {
        const prices = entries
          .filter((listing) => listing.priceChf && listing.priceChf > 0)
          .map((listing) => listing.priceChf!)
          .sort((a, b) => a - b);
        const mileages = entries
          .filter((listing) => listing.mileageKm && listing.mileageKm > 0)
          .map((listing) => listing.mileageKm!)
          .sort((a, b) => a - b);
        return {
          model,
          count: entries.length,
          medianPrice: prices.length ? percentile(prices, 0.5) : null,
          medianMileage: mileages.length ? percentile(mileages, 0.5) : null,
        };
      });
    container.innerHTML = ` <div class="segmentation-row heading"> <span>Model</span> <span>Count</span> <span>Median Price</span> <span>Median KM</span> </div> ${rows.map((row) => ` <div class="segmentation-row"> <span>${escapeHtml(row.model)}</span> <strong>${row.count}</strong> <strong> ${row.medianPrice !== null ? formatChf(row.medianPrice) : "—"} </strong> <strong> ${row.medianMileage !== null ? `${formatNumber(row.medianMileage)} km` : "—"} </strong> </div> `).join("")} `;
  }
  function renderCantons(listings: Listing[]) {
    const counts = new Map<string, number>();
    listings.forEach((listing) => {
      const canton = parseCanton(listing.location);
      counts.set(canton, (counts.get(canton) ?? 0) + 1);
    });
    const rows = Array.from(counts.entries())
      .sort(([, a], [, b]) => b - a)
      .slice(0, 8);
    const container = document.getElementById("canton-list");
    if (!container) return;
    container.innerHTML = rows
      .map(
        ([canton, count]) =>
          ` <li> <span>${escapeHtml(canton)}</span> <strong>${count}</strong> </li> `,
      )
      .join("");
  }
  function renderMileageBuckets(listings: Listing[]) {
    const ranges = [
      { label: "<50k km", min: 0, max: 50_000 },
      { label: "50–100k km", min: 50_000, max: 100_000 },
      { label: "100–150k km", min: 100_000, max: 150_000 },
      { label: "150–200k km", min: 150_000, max: 200_000 },
      { label: "200k+ km", min: 200_000, max: Infinity },
    ];
    const buckets = ranges.map((range) => {
      const entries = listings.filter(
        (listing) =>
          listing.priceChf &&
          listing.priceChf > 0 &&
          listing.mileageKm &&
          listing.mileageKm > range.min &&
          listing.mileageKm <= range.max,
      );
      const prices = entries
        .map((listing) => listing.priceChf!)
        .sort((a, b) => a - b);
      return {
        label: range.label,
        count: entries.length,
        medianPrice: prices.length ? percentile(prices, 0.5) : null,
      };
    });
    renderBars(
      "mileage-buckets",
      buckets.map((bucket) => ({
        label: bucket.label,
        value: bucket.count,
        secondary:
          bucket.medianPrice !== null ? formatChf(bucket.medianPrice) : "—",
      })),
    );
  }
  function renderWeeklyListings(listings: Listing[]) {
    const weekCounts = new Map<string, number>();
    const dayMs = 1000 * 60 * 60 * 24;
    listings.forEach((listing) => {
      if (!listing.createDate) return;
      const created = new Date(listing.createDate);
      if (Number.isNaN(created.valueOf())) {
        return;
      }
      const weekIndex = Math.floor(created.valueOf() / (7 * dayMs));
      const weekKey = `${created.getFullYear()}-W${weekIndex}`;
      weekCounts.set(weekKey, (weekCounts.get(weekKey) ?? 0) + 1);
    });
    const rows = Array.from(weekCounts.entries())
      .sort(([a], [b]) => a.localeCompare(b))
      .slice(-8);
    renderBars(
      "weekly-listings",
      rows.map(([week, count]) => ({ label: week, value: count })),
    );
    setText(
      "stat-new",
      rows.reduce((sum, [, count]) => sum + count, 0),
    );
  }
  function renderInventoryAge(listings: Listing[]) {
    const ages = listings
      .map(getAgeDays)
      .filter((value): value is number => typeof value === "number");
    const buckets = [
      { label: "0–7 days", min: 0, max: 7 },
      { label: "8–30 days", min: 8, max: 30 },
      { label: "31–90 days", min: 31, max: 90 },
      { label: "90+ days", min: 91, max: Infinity },
    ].map((bucket) => ({
      label: bucket.label,
      value: ages.filter((age) => age >= bucket.min && age <= bucket.max)
        .length,
    }));
    renderBars("inventory-age", buckets);
  }
  function renderAvailabilityIntelligence(listings: Listing[]) {
    const cantonCounts = new Map<string, number>();
    listings.forEach((listing) => {
      const canton = parseCanton(listing.location);
      cantonCounts.set(canton, (cantonCounts.get(canton) ?? 0) + 1);
    });
    const topCantons = Array.from(cantonCounts.entries())
      .sort(([, a], [, b]) => b - a)
      .slice(0, 3);
    const concentration =
      listings.length > 0
        ? Math.round(
            (topCantons.reduce((sum, [, count]) => sum + count, 0) /
              listings.length) *
              100,
          )
        : 0;
    setText("supply-concentration", `${concentration}%`);
    const topContainer = document.getElementById("top-cantons");
    if (topContainer) {
      topContainer.innerHTML = topCantons
        .map(
          ([canton, count]) =>
            ` <li> <span>${escapeHtml(canton)}</span> <strong>${count}</strong> </li> `,
        )
        .join("");
    }
    const modelCounts = new Map<string, number>();
    listings.forEach((listing) => {
      const model = getModelName(listing);
      modelCounts.set(model, (modelCounts.get(model) ?? 0) + 1);
    });
    const maxModelCount = Math.max(...modelCounts.values(), 1);
    const scarcity = Array.from(modelCounts.entries())
      .map(([model, count]) => ({
        model,
        count,
        scarcity: Math.round((1 - count / maxModelCount) * 100),
      }))
      .sort((a, b) => b.scarcity - a.scarcity);
    const scarcityContainer = document.getElementById("model-scarcity");
    if (scarcityContainer) {
      scarcityContainer.innerHTML = scarcity
        .map(
          (row) =>
            ` <div class="segmentation-row scarcity-row"> <span>${escapeHtml(row.model)}</span> <strong>${row.count}</strong> <strong>${row.scarcity}% scarcity</strong> <div class="bar-shell"> <div class="bar" style="width:${row.scarcity}%" ></div> </div> </div> `,
        )
        .join("");
    }
    const searchDifficulty = Math.round(
      Math.max(
        0,
        Math.min(
          100,
          (1 - listings.length / 200) * 50 +
            (1 - cantonCounts.size / 26) * 25 +
            (percentile(
              listings
                .filter((listing) => listing.mileageKm && listing.mileageKm > 0)
                .map((listing) => listing.mileageKm!),
              0.5,
            ) /
              250_000) *
              25,
        ),
      ),
    );
    setText("search-difficulty", `${searchDifficulty}/100`);
    const difficultyFill = document.getElementById("search-difficulty-fill");
    if (difficultyFill) {
      difficultyFill.style.width = `${searchDifficulty}%`;
    }
    const cantonModelContainer = document.getElementById("canton-availability");
    if (cantonModelContainer) {
      const modelsInData = Array.from(modelCounts.keys());
      const cantonRows = Array.from(cantonCounts.entries()).sort(
        ([, a], [, b]) => b - a,
      );
      cantonModelContainer.innerHTML = cantonRows
        .map(([canton, total]) => {
          const modelValues = modelsInData
            .map((model) => {
              const count = listings.filter(
                (listing) =>
                  parseCanton(listing.location) === canton &&
                  getModelName(listing) === model,
              ).length;
              return ` <span> ${escapeHtml(model)}: ${count} </span> `;
            })
            .join("");
          return ` <div class="segmentation-row canton-model-row"> <strong>${escapeHtml(canton)}</strong> ${modelValues} <strong>Total ${total}</strong> </div> `;
        })
        .join("");
    }
  }
  function renderPriceMetrics(listings: Listing[]) {
    const prices = listings
      .map((listing) => listing.priceChf!)
      .filter((price) => price > 0)
      .sort((a, b) => a - b);
    if (!prices.length) {
      return;
    }
    const median = percentile(prices, 0.5);
    const q1 = percentile(prices, 0.25);
    const q3 = percentile(prices, 0.75);
    const iqr = q3 - q1;
    setText("stat-price", formatChf(median));
    setText("median-price", formatChf(median));
    setText("price-q1", formatChf(q1));
    setText("price-q3", formatChf(q3));
    setText("price-iqr", formatChf(iqr));
    setText("distribution-q1", formatChf(q1));
    setText("distribution-q3", formatChf(q3));
    setText("distribution-median", `Median ${formatChf(median)}`);
    const rangeFill = document.getElementById("price-range-fill");
    if (rangeFill) {
      rangeFill.style.left = `${(q1 / q3) * 100}%`;
      rangeFill.style.width = `${((q3 - q1) / q3) * 100}%`;
    }
    const pricePerThousand = listings
      .filter(
        (listing) =>
          listing.priceChf &&
          listing.priceChf > 0 &&
          listing.mileageKm &&
          listing.mileageKm > 0,
      )
      .map((listing) => listing.priceChf! / (listing.mileageKm! / 1000))
      .sort((a, b) => a - b);
    if (pricePerThousand.length) {
      const average =
        pricePerThousand.reduce((sum, value) => sum + value, 0) /
        pricePerThousand.length;
      const medianPerThousand = percentile(pricePerThousand, 0.5);
      setText("price-per-km", `${formatChf(average)} / 1,000 km`);
      setText("median-price-per-km", `Median: ${formatChf(medianPerThousand)}`);
    }
  }
  function renderMileageMetrics(listings: Listing[]) {
    const mileages = listings
      .filter((listing) => listing.mileageKm && listing.mileageKm > 0)
      .map((listing) => listing.mileageKm!)
      .sort((a, b) => a - b);
    if (!mileages.length) {
      return;
    }
    const median = percentile(mileages, 0.5);
    const q1 = percentile(mileages, 0.25);
    const q3 = percentile(mileages, 0.75);
    const iqr = q3 - q1;
    setText("median-mileage", `${formatNumber(median)} km`);
    setText(
      "mileage-percentiles",
      `Q1: ${formatNumber(q1)} km · Q3: ${formatNumber(q3)} km`,
    );
    setText("mileage-iqr", `IQR: ${formatNumber(iqr)} km`);
    setText("mileage-q1", `${formatNumber(q1)} km`);
    setText("mileage-q3", `${formatNumber(q3)} km`);
    setText("mileage-median", `Median: ${formatNumber(median)} km`);
    const maxMileage = Math.max(...mileages, 1);
    const mileageFill = document.getElementById("mileage-range-fill");
    if (mileageFill) {
      mileageFill.style.left = `${(q1 / maxMileage) * 100}%`;
      mileageFill.style.width = `${((q3 - q1) / maxMileage) * 100}%`;
    }
    renderMileageBuckets(listings);
  }
  function renderDaysOnMarket(listings: Listing[]) {
    const ages = listings
      .map(getAgeDays)
      .filter((value): value is number => typeof value === "number");
    const average = ages.length
      ? Math.round(ages.reduce((sum, value) => sum + value, 0) / ages.length)
      : 0;
    setText("stat-days", average);
    setText("supply-days", `${average} days`);
  }
  function renderDashboard(rawListings: Listing[]) {
    /* * Keep the same semantics as the original SSR implementation: * listings without a positive asking price are not active listings. */ const listings =
      rawListings.filter((listing) => listing.priceChf && listing.priceChf > 0);
    setText("stat-active", listings.length);
    setText("supply-active", listings.length);
    renderPriceMetrics(listings);
    renderMileageMetrics(listings);
    renderDaysOnMarket(listings);
    renderWeeklyListings(listings);
    renderInventoryAge(listings);
    renderModelSegmentation(listings);
    renderCantons(listings);
    renderAvailabilityIntelligence(listings);
    drawYearBoxplot(listings);
    drawPriceMileageScatter(listings);
  }
  async function loadDataset(key: string) {
    const loading = document.getElementById("loading-state");
    const error = document.getElementById("error-state");
    if (loading) {
      loading.removeAttribute("hidden");
    }
    if (error) {
      error.setAttribute("hidden", "");
      error.textContent = "";
    }
    clearDashboard();
    try {
      /* * IMPORTANT: * * `key` is generated from the same model name used by the * server-rendered selector. * * Example: * * key = "comparis-defender-90" * * becomes: * * /data/comparis-defender-90.json */ const response =
        await fetch(`/data/${key}.json`, { cache: "no-store" });
      if (!response.ok) {
        throw new Error(`Failed to load ${key}.json (${response.status})`);
      }
      const data = (await response.json()) as unknown;
      if (!Array.isArray(data)) {
        throw new Error("Dataset is not an array.");
      }
      renderDashboard(data as Listing[]);
    } catch (loadError) {
      console.error(loadError);
      if (error) {
        error.textContent =
          loadError instanceof Error
            ? loadError.message
            : "Unable to load dataset.";
        error.removeAttribute("hidden");
      }
    } finally {
      if (loading) {
        loading.setAttribute("hidden", "");
      }
    }
  }
  select?.addEventListener("change", () => {
    const key = select.value;
    /* * Optional URL state: * * /dashboard?dataset=comparis-defender-110 * * This does NOT reload the page. */ const url =
      new URL(window.location.href);
    url.searchParams.set("dataset", key);
    window.history.replaceState({}, "", url);
    void loadDataset(key);
  });
  window.addEventListener("resize", () => {
    const activeKey = select?.value;
    if (!activeKey) return;
    /* * Re-fetching is unnecessary. The canvases * are redrawn by the normal resize handler below * only if we keep the currently loaded data. */ window.dispatchEvent(
      new CustomEvent("dashboard-resize"),
    );
  });
  /* * Initial dataset. * * If ?dataset=... is present, use it. Otherwise use * the first model in the dropdown. */ const initialParams =
    new URLSearchParams(window.location.search);
  const initialKey =
    initialParams.get("dataset") ||
    defaultDatasetKey ||
    availableModels[0]?.key;
  if (initialKey && select) {
    const exists = Array.from(select.options).some(
      (option) => option.value === initialKey,
    );
    if (exists) {
      select.value = initialKey;
    }
  }
  /* * Keep the latest data in memory so canvas charts can * be redrawn without another HTTP request. */ let currentListings: Listing[] =
    [];
  const originalLoadDataset = loadDataset;
  /* * Wrap the loader so resize can redraw the current dataset. */ async function loadAndRemember(
    key: string,
  ) {
    const loading = document.getElementById("loading-state");
    const error = document.getElementById("error-state");
    if (loading) {
      loading.removeAttribute("hidden");
    }
    if (error) {
      error.setAttribute("hidden", "");
    }
    try {
      const response = await fetch(`/data/${key}.json`, { cache: "no-store" });
      if (!response.ok) {
        throw new Error(`Failed to load ${key}.json (${response.status})`);
      }
      const data = (await response.json()) as unknown;
      if (!Array.isArray(data)) {
        throw new Error("Dataset is not an array.");
      }
      currentListings = data as Listing[];
      renderDashboard(currentListings);
    } catch (loadError) {
      console.error(loadError);
      clearDashboard();
      if (error) {
        error.textContent =
          loadError instanceof Error
            ? loadError.message
            : "Unable to load dataset.";
        error.removeAttribute("hidden");
      }
    } finally {
      if (loading) {
        loading.setAttribute("hidden", "");
      }
    }
  }
  select?.addEventListener("change", () => {
    const key = select.value;
    const url = new URL(window.location.href);
    url.searchParams.set("dataset", key);
    window.history.replaceState({}, "", url);
    void loadAndRemember(key);
  });
  window.addEventListener("dashboard-resize", () => {
    if (!currentListings.length) return;
    const listings = currentListings.filter(
      (listing) => listing.priceChf && listing.priceChf > 0,
    );
    drawYearBoxplot(listings);
    drawPriceMileageScatter(listings);
  });
  /* * Debounced browser resize. */ let resizeTimer: number | undefined;
  window.addEventListener("resize", () => {
    window.clearTimeout(resizeTimer);
    resizeTimer = window.setTimeout(() => {
      window.dispatchEvent(new CustomEvent("dashboard-resize"));
    }, 150);
  });
  if (initialKey) {
    await loadAndRemember(initialKey);
  }
</script>
